{
  "type": "test-group",
  "name": "Kalkulationstool Audit",
  "description": "Praxisnahe WebInspector-Prüfung für das Kalkulationstool: Dokument-Metadaten, Labels, Bedienelemente, ARIA-Verweise, Tabellen und Überschriften.",
  "tests": [
    {
      "type": "test-group",
      "name": "Dokument",
      "description": "Grundlegende Dokument-Metadaten.",
      "tests": [
        {
          "type": "test-case",
          "name": "document-title",
          "description": "Die Seite muss einen aussagekräftigen Dokumenttitel haben.",
          "test": "function() {\n  let title = document.title.trim();\n  return {\n    level: title ? \"pass\" : \"fail\",\n    title,\n    message: title ? \"Dokumenttitel vorhanden.\" : \"Dokumenttitel fehlt.\"\n  };\n}"
        },
        {
          "type": "test-case",
          "name": "document-language",
          "description": "Das HTML-Dokument muss eine passende Sprache deklarieren.",
          "test": "function() {\n  let lang = document.documentElement.getAttribute(\"lang\") || \"\";\n  let level = lang.trim() ? \"pass\" : \"fail\";\n  let result = {\n    level,\n    lang,\n    message: level === \"pass\" ? \"Dokumentsprache ist gesetzt.\" : \"Das lang-Attribut auf <html> fehlt.\"\n  };\n  if (level !== \"pass\") {\n    result.domNodes = [document.documentElement];\n    result.domAttributes = [\"lang\"];\n  }\n  return result;\n}"
        },
        {
          "type": "test-case",
          "name": "main-landmark",
          "description": "Die Seite sollte genau einen Hauptbereich haben.",
          "test": "function() {\n  let mains = Array.from(document.querySelectorAll(\"main, [role='main']\"));\n  let level = mains.length === 1 ? \"pass\" : \"warn\";\n  let result = {\n    level,\n    count: mains.length,\n    message: mains.length === 1 ? \"Genau ein Hauptbereich vorhanden.\" : \"Es sollte genau ein <main> oder role='main' vorhanden sein.\"\n  };\n  if (level !== \"pass\") {\n    result.domNodes = mains.length ? mains : [document.body];\n  }\n  return result;\n}"
        }
      ]
    },
    {
      "type": "test-group",
      "name": "DOM-Struktur",
      "description": "Prüft robuste DOM-Struktur und vermeidbare Stolperstellen.",
      "tests": [
        {
          "type": "test-case",
          "name": "duplicate-ids",
          "description": "IDs müssen eindeutig sein.",
          "test": "function() {\n  let byId = new Map();\n  for (let element of document.querySelectorAll(\"[id]\")) {\n    let id = element.id.trim();\n    if (!id)\n      continue;\n    if (!byId.has(id))\n      byId.set(id, []);\n    byId.get(id).push(element);\n  }\n  let duplicates = [];\n  for (let nodes of byId.values()) {\n    if (nodes.length > 1)\n      duplicates.push(...nodes);\n  }\n  let level = duplicates.length ? \"fail\" : \"pass\";\n  let result = {\n    level,\n    duplicateCount: duplicates.length,\n    message: duplicates.length ? \"Es gibt doppelte IDs.\" : \"Keine doppelten IDs gefunden.\"\n  };\n  if (level !== \"pass\") {\n    result.domNodes = duplicates;\n    result.domAttributes = [\"id\"];\n  }\n  return result;\n}"
        },
        {
          "type": "test-case",
          "name": "positive-tabindex",
          "description": "Positive tabindex-Werte sollten vermieden werden, da sie die natürliche Tastaturreihenfolge stören.",
          "test": "function() {\n  let nodes = Array.from(document.querySelectorAll(\"[tabindex]\")).filter((element) => Number(element.getAttribute(\"tabindex\")) > 0);\n  let level = nodes.length ? \"warn\" : \"pass\";\n  let result = {\n    level,\n    count: nodes.length,\n    message: nodes.length ? \"Positive tabindex-Werte gefunden.\" : \"Keine positiven tabindex-Werte gefunden.\"\n  };\n  if (level !== \"pass\") {\n    result.domNodes = nodes;\n    result.domAttributes = [\"tabindex\"];\n  }\n  return result;\n}"
        }
      ]
    },
    {
      "type": "test-group",
      "name": "Bedienelemente",
      "description": "Prüft, ob Formularfelder, Buttons und Links für assistive Technologien benannt sind.",
      "tests": [
        {
          "type": "test-case",
          "name": "form-controls-have-names",
          "description": "Alle sichtbaren Formularfelder brauchen einen zugänglichen Namen.",
          "test": "function() {\n  function isHidden(element) {\n    if (element.type === \"hidden\" || element.hidden || element.closest(\"[hidden], [aria-hidden='true']\"))\n      return true;\n    let style = window.getComputedStyle(element);\n    return style.display === \"none\" || style.visibility === \"hidden\";\n  }\n  function referencedText(element, attribute) {\n    return (element.getAttribute(attribute) || \"\").split(/\\s+/).map((id) => document.getElementById(id)).filter(Boolean).map((node) => node.textContent.trim()).join(\" \").trim();\n  }\n  function hasLabel(element) {\n    if ((element.getAttribute(\"aria-label\") || \"\").trim())\n      return true;\n    if (referencedText(element, \"aria-labelledby\"))\n      return true;\n    if (element.closest(\"label\"))\n      return true;\n    if (element.id && Array.from(document.querySelectorAll(\"label\")).some((label) => label.htmlFor === element.id))\n      return true;\n    return false;\n  }\n  let controls = Array.from(document.querySelectorAll(\"input, select, textarea\")).filter((element) => !isHidden(element));\n  let missing = controls.filter((element) => !hasLabel(element));\n  let level = missing.length ? \"fail\" : \"pass\";\n  let result = {\n    level,\n    checkedCount: controls.length,\n    missingCount: missing.length,\n    message: missing.length ? \"Formularfelder ohne zugänglichen Namen gefunden.\" : \"Alle Formularfelder haben einen zugänglichen Namen.\"\n  };\n  if (level !== \"pass\") {\n    result.domNodes = missing;\n    result.domAttributes = [\"aria-label\", \"aria-labelledby\", \"id\"];\n  }\n  return result;\n}"
        },
        {
          "type": "test-case",
          "name": "buttons-have-names",
          "description": "Buttons und Elemente mit role='button' brauchen einen zugänglichen Namen.",
          "test": "function() {\n  function referencedText(element, attribute) {\n    return (element.getAttribute(attribute) || \"\").split(/\\s+/).map((id) => document.getElementById(id)).filter(Boolean).map((node) => node.textContent.trim()).join(\" \").trim();\n  }\n  function nameOf(element) {\n    return [element.textContent, element.getAttribute(\"aria-label\"), referencedText(element, \"aria-labelledby\"), element.getAttribute(\"title\")].filter(Boolean).join(\" \").trim();\n  }\n  let controls = Array.from(document.querySelectorAll(\"button, [role='button']\"));\n  let missing = controls.filter((element) => !nameOf(element));\n  let level = missing.length ? \"fail\" : \"pass\";\n  let result = {\n    level,\n    checkedCount: controls.length,\n    missingCount: missing.length,\n    message: missing.length ? \"Buttons ohne zugänglichen Namen gefunden.\" : \"Alle Buttons haben einen zugänglichen Namen.\"\n  };\n  if (level !== \"pass\") {\n    result.domNodes = missing;\n    result.domAttributes = [\"aria-label\", \"aria-labelledby\", \"role\", \"title\"];\n  }\n  return result;\n}"
        },
        {
          "type": "test-case",
          "name": "links-have-names",
          "description": "Links brauchen einen zugänglichen Namen.",
          "test": "function() {\n  function referencedText(element, attribute) {\n    return (element.getAttribute(attribute) || \"\").split(/\\s+/).map((id) => document.getElementById(id)).filter(Boolean).map((node) => node.textContent.trim()).join(\" \").trim();\n  }\n  function imageText(element) {\n    return Array.from(element.querySelectorAll(\"img[alt]\")).map((image) => image.getAttribute(\"alt\").trim()).join(\" \").trim();\n  }\n  function nameOf(element) {\n    return [element.textContent, imageText(element), element.getAttribute(\"aria-label\"), referencedText(element, \"aria-labelledby\"), element.getAttribute(\"title\")].filter(Boolean).join(\" \").trim();\n  }\n  let links = Array.from(document.querySelectorAll(\"a[href]\"));\n  let missing = links.filter((element) => !nameOf(element));\n  let level = missing.length ? \"fail\" : \"pass\";\n  let result = {\n    level,\n    checkedCount: links.length,\n    missingCount: missing.length,\n    message: missing.length ? \"Links ohne zugänglichen Namen gefunden.\" : \"Alle Links haben einen zugänglichen Namen.\"\n  };\n  if (level !== \"pass\") {\n    result.domNodes = missing;\n    result.domAttributes = [\"href\", \"aria-label\", \"aria-labelledby\", \"title\"];\n  }\n  return result;\n}"
        }
      ]
    },
    {
      "type": "test-group",
      "name": "ARIA",
      "description": "Prüft ARIA-Referenzen und Rollen auf offensichtliche Fehler.",
      "tests": [
        {
          "type": "test-case",
          "name": "aria-references-exist",
          "description": "ARIA-Attribute, die auf IDs verweisen, müssen existierende Ziele referenzieren.",
          "test": "function() {\n  let referenceAttributes = [\"aria-labelledby\", \"aria-describedby\", \"aria-controls\", \"aria-owns\", \"aria-activedescendant\", \"aria-flowto\"];\n  let invalid = [];\n  for (let element of document.querySelectorAll(referenceAttributes.map((name) => \"[\" + name + \"]\").join(\",\"))) {\n    for (let attribute of referenceAttributes) {\n      let value = element.getAttribute(attribute);\n      if (!value)\n        continue;\n      let ids = value.split(/\\s+/).filter(Boolean);\n      if (ids.some((id) => !document.getElementById(id))) {\n        invalid.push(element);\n        break;\n      }\n    }\n  }\n  let level = invalid.length ? \"fail\" : \"pass\";\n  let result = {\n    level,\n    invalidCount: invalid.length,\n    message: invalid.length ? \"Ungültige ARIA-ID-Referenzen gefunden.\" : \"Alle ARIA-ID-Referenzen zeigen auf vorhandene Elemente.\"\n  };\n  if (level !== \"pass\") {\n    result.domNodes = invalid;\n    result.domAttributes = referenceAttributes;\n  }\n  return result;\n}"
        },
        {
          "type": "test-case",
          "name": "aria-hidden-focusable",
          "description": "Fokussierbare Elemente dürfen nicht in aria-hidden-Bereichen liegen.",
          "test": "function() {\n  function isFocusable(element) {\n    if (element.disabled || element.hidden)\n      return false;\n    let selector = \"a[href], button, input, select, textarea, summary, [tabindex]\";\n    if (!element.matches(selector))\n      return false;\n    return element.getAttribute(\"tabindex\") !== \"-1\";\n  }\n  let nodes = Array.from(document.querySelectorAll(\"[aria-hidden='true'] *\")).filter(isFocusable);\n  let level = nodes.length ? \"fail\" : \"pass\";\n  let result = {\n    level,\n    count: nodes.length,\n    message: nodes.length ? \"Fokussierbare Elemente in aria-hidden-Bereichen gefunden.\" : \"Keine fokussierbaren Elemente in aria-hidden-Bereichen gefunden.\"\n  };\n  if (level !== \"pass\") {\n    result.domNodes = nodes;\n    result.domAttributes = [\"aria-hidden\", \"tabindex\"];\n  }\n  return result;\n}"
        }
      ]
    },
    {
      "type": "test-group",
      "name": "Inhalt",
      "description": "Prüft Bilder, Tabellen und Überschriften.",
      "tests": [
        {
          "type": "test-case",
          "name": "images-have-alt",
          "description": "Bilder brauchen ein alt-Attribut. Dekorative Bilder erhalten alt=''.",
          "test": "function() {\n  let images = Array.from(document.images);\n  let missing = images.filter((image) => !image.hasAttribute(\"alt\"));\n  let level = missing.length ? \"fail\" : \"pass\";\n  let result = {\n    level,\n    checkedCount: images.length,\n    missingCount: missing.length,\n    message: missing.length ? \"Bilder ohne alt-Attribut gefunden.\" : \"Alle Bilder haben ein alt-Attribut.\"\n  };\n  if (level !== \"pass\") {\n    result.domNodes = missing;\n    result.domAttributes = [\"alt\"];\n  }\n  return result;\n}"
        },
        {
          "type": "test-case",
          "name": "data-tables-have-headers",
          "description": "Tabellen mit Datenzellen brauchen Tabellenüberschriften.",
          "test": "function() {\n  let tables = Array.from(document.querySelectorAll(\"table\"));\n  let failing = tables.filter((table) => table.querySelector(\"td\") && !table.querySelector(\"th\"));\n  let level = failing.length ? \"fail\" : \"pass\";\n  let result = {\n    level,\n    checkedCount: tables.length,\n    failingCount: failing.length,\n    message: failing.length ? \"Datentabellen ohne <th>-Überschriften gefunden.\" : \"Alle Datentabellen haben Überschriften.\"\n  };\n  if (level !== \"pass\") {\n    result.domNodes = failing;\n  }\n  return result;\n}"
        },
        {
          "type": "test-case",
          "name": "heading-order",
          "description": "Überschriften sollten keine Ebenen überspringen.",
          "test": "function() {\n  let headings = Array.from(document.querySelectorAll(\"h1, h2, h3, h4, h5, h6\"));\n  let previous = 0;\n  let skipped = [];\n  for (let heading of headings) {\n    let level = Number(heading.tagName.slice(1));\n    if (previous && level > previous + 1)\n      skipped.push(heading);\n    previous = level;\n  }\n  let resultLevel = skipped.length ? \"warn\" : \"pass\";\n  let result = {\n    level: resultLevel,\n    checkedCount: headings.length,\n    skippedCount: skipped.length,\n    message: skipped.length ? \"Überschriften überspringen Ebenen.\" : \"Überschriftenreihenfolge ist plausibel.\"\n  };\n  if (resultLevel !== \"pass\") {\n    result.domNodes = skipped;\n  }\n  return result;\n}"
        }
      ]
    }
  ]
}
